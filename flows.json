    {
        "id": "2bae19c188b25f32",
        "type": "ui_template",
        "z": "2d82a9501e17c8ac",
        "group": "bb6f13b3a50630a2",
        "name": "",
        "order": 0,
        "width": "9",
        "height": "5",
        "format": "<style>\n    .header-right {\n        text-align: right;\n        font-family: 'Orbitron', 'Courier New', monospace;\n    }\n\n    .time-wrapper {\n        background: rgba(0, 0, 0, 0.3);\n        border: 1px solid rgba(255, 255, 255, 0.1);\n        border-radius: 16px;\n        padding: 16px 24px;\n        backdrop-filter: blur(10px);\n        position: relative;\n        overflow: hidden;\n        width: 420px;\n        margin-left: auto;\n    }\n\n    .time-wrapper::before {\n        content: '';\n        position: absolute;\n        top: 0;\n        left: -100%;\n        width: 100%;\n        height: 1px;\n        background: linear-gradient(90deg, transparent, #00ffff, transparent);\n        animation: scan 3s infinite;\n    }\n\n    @keyframes scan {\n        0% {\n            left: -100%;\n        }\n\n        100% {\n            left: 100%;\n        }\n    }\n\n    .date-row {\n        display: flex;\n        align-items: center;\n        justify-content: flex-end;\n        gap: 10px;\n        margin-bottom: 8px;\n        height: 18px;\n    }\n\n    .date-text {\n        font-size: 12px;\n        color: #64ffda;\n        letter-spacing: 2px;\n        white-space: nowrap;\n        flex: 1;\n        text-align: right;\n    }\n\n    .date-glow {\n        width: 6px;\n        height: 6px;\n        background: #64ffda;\n        border-radius: 50%;\n        box-shadow: 0 0 10px #64ffda, 0 0 20px #64ffda;\n        animation: pulse-glow 2s infinite;\n        flex-shrink: 0;\n    }\n\n    @keyframes pulse-glow {\n\n        0%,\n        100% {\n            box-shadow: 0 0 5px #64ffda, 0 0 10px #64ffda;\n        }\n\n        50% {\n            box-shadow: 0 0 15px #64ffda, 0 0 30px #64ffda;\n        }\n    }\n\n    .time-row {\n        display: flex;\n        align-items: center;\n        justify-content: flex-end;\n        gap: 2px;\n    }\n\n    .time-block {\n        background: rgba(0, 255, 255, 0.05);\n        border: 1px solid rgba(0, 255, 255, 0.2);\n        border-radius: 8px;\n        padding: 8px 12px;\n        font-size: 42px;\n        font-weight: 900;\n        color: #00ffff;\n        text-shadow: 0 0 20px rgba(0, 255, 255, 0.5);\n        letter-spacing: 4px;\n        position: relative;\n        width: 70px;\n        text-align: center;\n        flex-shrink: 0;\n        font-family: 'Orbitron', 'Courier New', monospace;\n    }\n\n    .time-block::after {\n        content: '';\n        position: absolute;\n        bottom: -2px;\n        left: 10%;\n        width: 80%;\n        height: 2px;\n        background: #00ffff;\n        box-shadow: 0 0 10px #00ffff;\n    }\n\n    .time-separator {\n        font-size: 36px;\n        color: #ff00ff;\n        text-shadow: 0 0 15px #ff00ff;\n        animation: flicker 1.5s infinite;\n        margin: 0 4px;\n        width: 20px;\n        text-align: center;\n        flex-shrink: 0;\n        display: inline-block;\n    }\n\n    @keyframes flicker {\n\n        0%,\n        100% {\n            opacity: 1;\n        }\n\n        50% {\n            opacity: 0.3;\n        }\n    }\n\n    .seconds-colon {\n        font-size: 18px;\n        color: #ff00ff;\n        text-shadow: 0 0 10px #ff00ff;\n        width: 10px;\n        text-align: center;\n        flex-shrink: 0;\n        display: inline-block;\n    }\n\n    .seconds-block {\n        font-size: 22px;\n        font-weight: 700;\n        color: #ff00ff;\n        text-shadow: 0 0 15px #ff00ff;\n        letter-spacing: 2px;\n        width: 32px;\n        text-align: center;\n        flex-shrink: 0;\n        display: inline-block;\n        font-family: 'Orbitron', 'Courier New', monospace;\n    }\n\n    .ampm-badge {\n        background: rgba(255, 0, 255, 0.1);\n        border: 1px solid rgba(255, 0, 255, 0.3);\n        border-radius: 20px;\n        padding: 4px 10px;\n        font-size: 12px;\n        color: #ff00ff;\n        letter-spacing: 2px;\n        margin-left: 12px;\n        text-shadow: 0 0 10px #ff00ff;\n        width: 36px;\n        text-align: center;\n        flex-shrink: 0;\n        display: inline-block;\n    }\n\n    .subtitle-neon {\n        font-size: 10px;\n        letter-spacing: 6px;\n        color: rgba(255, 255, 255, 0.4);\n        margin-top: 8px;\n        text-transform: uppercase;\n        white-space: nowrap;\n        text-align: right;\n    }\n\n    .corner-decor {\n        position: absolute;\n        width: 10px;\n        height: 10px;\n        border-color: #00ffff;\n        border-style: solid;\n    }\n\n    .corner-tl {\n        top: 4px;\n        left: 4px;\n        border-width: 2px 0 0 2px;\n    }\n\n    .corner-tr {\n        top: 4px;\n        right: 4px;\n        border-width: 2px 2px 0 0;\n    }\n\n    .corner-bl {\n        bottom: 4px;\n        left: 4px;\n        border-width: 0 0 2px 2px;\n    }\n\n    .corner-br {\n        bottom: 4px;\n        right: 4px;\n        border-width: 0 2px 2px 0;\n    }\n</style>\n\n<div class=\"header-right\">\n    <div class=\"time-wrapper\" id=\"timeWrapper\">\n        <div class=\"corner-decor corner-tl\"></div>\n        <div class=\"corner-decor corner-tr\"></div>\n        <div class=\"corner-decor corner-bl\"></div>\n        <div class=\"corner-decor corner-br\"></div>\n\n        <div class=\"date-row\">\n            <span class=\"date-text\" id=\"dateDisplay\">TUESDAY, APRIL 28, 2026</span>\n            <div class=\"date-glow\"></div>\n        </div>\n\n        <div class=\"time-row\">\n            <div class=\"time-block\" id=\"hourDisplay\">03</div>\n            <span class=\"time-separator\">:</span>\n            <div class=\"time-block\" id=\"minuteDisplay\">40</div>\n            <span class=\"seconds-colon\">:</span>\n            <span class=\"seconds-block\" id=\"secondDisplay\">11</span>\n            <span class=\"ampm-badge\" id=\"ampmDisplay\">PM</span>\n        </div>\n\n        <div class=\"subtitle-neon\">◆ SmartBuilding ◆</div>\n    </div>\n</div>\n\n<script>\n    (function() {\n    const months = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];\n    const days = ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];\n    \n    // Get elements once\n    const dateEl = document.getElementById('dateDisplay');\n    const hourEl = document.getElementById('hourDisplay');\n    const minEl = document.getElementById('minuteDisplay');\n    const secEl = document.getElementById('secondDisplay');\n    const ampmEl = document.getElementById('ampmDisplay');\n    \n    // Store previous values to only update when changed\n    let prevDate = '';\n    let prevHour = '';\n    let prevMin = '';\n    let prevSec = '';\n    let prevAmpm = '';\n    \n    function updateDateTime() {\n        const now = new Date();\n        \n        // Date - only changes at midnight\n        const dateStr = days[now.getDay()] + ', ' + months[now.getMonth()] + ' ' + now.getDate() + ', ' + now.getFullYear();\n        if (dateStr !== prevDate) {\n            dateEl.textContent = dateStr;\n            prevDate = dateStr;\n        }\n        \n        // Time\n        let hours = now.getHours();\n        const ampm = hours >= 12 ? 'PM' : 'AM';\n        hours = hours % 12 || 12;\n        const hourStr = String(hours).padStart(2, '0');\n        const minStr = String(now.getMinutes()).padStart(2, '0');\n        const secStr = String(now.getSeconds()).padStart(2, '0');\n        \n        // Only update if value changed\n        if (hourStr !== prevHour) { hourEl.textContent = hourStr; prevHour = hourStr; }\n        if (minStr !== prevMin) { minEl.textContent = minStr; prevMin = minStr; }\n        if (secStr !== prevSec) { secEl.textContent = secStr; prevSec = secStr; }\n        if (ampm !== prevAmpm) { ampmEl.textContent = ampm; prevAmpm = ampm; }\n    }\n    \n    updateDateTime();\n    setInterval(updateDateTime, 1000);\n})();\n</script>",
